data/*.csv
data/*.json
!data/email_templates/
!data/playbooks/

# Local Multi-Agent Vector Database Stores
chroma_db/
faiss_index/

# System-Generated Deliverables & PDF Reports
*.pdf
api/exports/

# Integrated Development Environments (IDEs) Settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj

# Operating System Specific Files
.DS_Store
Thumbs.db